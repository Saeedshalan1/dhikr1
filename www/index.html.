 $('azkarBody').innerHTML=`<h1>أذكار الصباح والمساء</h1>
 <div class="row"><button class="chip${azM?' on':''}" data-am="1" style="flex:1">☀️ الصباح</button><button class="chip${!azM?' on':''}" data-am="0" style="flex:1">🌙 المساء</button></div>
 <div class="card" style="${all?'border-color:var(--gold)':''}"><div class="row"><b class="sp" style="color:${all?'var(--gold)':'var(--ink)'}">${all?`أتممت ${azM?'أذكار الصباح':'أذكار المساء'}، تقبّل الله منك 🤍`:`أنجزت ${n} من ${L.length}`}</b><b style="color:var(--em)">${Math.floor(n*100/L.length)}%</b></div>
 <div class="bar" style="margin:10px 0 6px"><i style="width:${n/L.length*100}%;${all?'background:var(--gold)':''}"></i></div>
 <div class="tiny dim">اضغط على الذكر بعد قراءته، ويكتمل عند بلوغ عدده.</div></div>
 ${L.map((z,i)=>{const d=c[i]>=z[1];return`<button class="zk${d?' done':''}" data-z="${i}"><p>${esc(z[0])}</p><div class="row"><span class="tiny dim sp">التكرار: ${timesL(z[1])}</span><span class="cnt">${d?'✓ تم':z[1]===1?'اضغط بعد القراءة':'بقي '+(z[1]-c[i])}</span></div></button>`}).join('')}
 <button class="btn ghost" data-azr="1">إعادة البدء</button>
 <p class="tiny" style="text-align:center;color:var(--faint);margin:0">نصوص الأذكار مأخوذة من الأذكار الصحيحة المشهورة؛ راجعها على حصن المسلم.</p>`;
};
$('azkarBody').addEventListener('click',e=>{
 const t=e.target.closest('button');if(!t)return;
 if(t.dataset.am!==undefined){azM=t.dataset.am==='1';renderAzkar();$('v-azkar').scrollTop=0;return}
 if(t.dataset.azr){confirmM('إعادة البدء','هل تريد تصفير عدّادات هذه الأذكار لليوم؟','تصفير',()=>{delete S.azkar[azKey(azM)];save();renderAzkar()});return}
 if(t.dataset.z!==undefined){
  const i=+t.dataset.z,L=AZKAR[azM?'m':'e'],c=azCounts(azM).slice();if(c[i]>=L[i][1])return;
  c[i]++;const today=key();Object.keys(S.azkar).forEach(k=>{if(!k.startsWith(today))delete S.azkar[k]});S.azkar[azKey(azM)]=c;
  const all=L.every((z,j)=>c[j]>=z[1]);
  if(all){S.azDone=true;sGoal();hGoal()}else if(c[i]>=L[i][1]){sTap();hMed()}else{sTap();hLight()}
  save();
  const card=t;card.classList.remove('pop');void card.offsetWidth;card.classList.add('pop');
  const y=$('v-azkar').scrollTop;renderAzkar();$('v-azkar').scrollTop=y;checkBadges();
 }
});

/* ===== الإحصائيات ===== */
let range=7;
const WD=['أحد','إثنين','ثلاثاء','أربعاء','خميس','جمعة','سبت'];
const renderStats=()=>{
 const g=S.settings.goal,ds=[...Array(range)].map((_,i)=>{const dt=addD(new Date(),-(range-1-i));return{dt,t:dayT(key(dt))}});
 const mx=Math.max(g,...ds.map(d=>d.t),1),L=level(),list=allAdhkar(),top=Math.max(1,...list.map(a=>S.totals[a.id]||0));
 $('statsBody').innerHTML=`<h1>إحصائياتك</h1>
 <div class="grid2">${[['اليوم',fmt(dayT(key()))],['السلسلة',fmt(streak())+' 🔥'],['أفضل سلسلة',fmt(maxS())],['المجموع الكلي',fmt(S.life)]].map(([a,b])=>`<div class="card stat"><span class="tiny dim">${a}</span><b>${b}</b></div>`).join('')}</div>
 <div class="card"><b style="color:var(--gold)">المستوى ${L.i}: ${L.name}</b><div class="bar" style="margin:10px 0 6px"><i style="width:${L.p*100}%;background:var(--gold)"></i></div>
 <div class="tiny dim">${L.next?`بقي ${fmt(L.next[0]-S.life)} ذكراً للوصول إلى «${L.next[1]}»`:'بلغت أعلى مستوى، تقبّل الله منك'}</div></div>
 <div class="card"><div class="row" style="margin-bottom:14px"><b class="sp">${range===7?'آخر 7 أيام':'آخر 30 يوماً'}</b>
 <button class="chip${range===7?' on':''}" data-r="7">أسبوع</button><button class="chip${range===30?' on':''}" data-r="30">شهر</button></div>
 <div class="chart"><div class="gl" style="bottom:${g/mx*100}%"></div>${ds.map(d=>`<div class="col"><i class="${d.t>=g?'done':''}" style="width:${range===7?22:6}px;height:${d.t?Math.max(3,d.t/mx*100):0}%"></i></div>`).join('')}</div>
 ${range===7?`<div class="days">${ds.map(d=>`<span>${WD[d.dt.getDay()]}</span>`).join('')}</div>`:''}
 <div class="row small dim" style="margin-top:12px"><span class="sp">المجموع: ${fmt(ds.reduce((a,d)=>a+d.t,0))}</span><span>أيام مكتملة: ${ds.filter(d=>d.t>=g).length} / ${range}</span></div></div>
 <div class="card"><p class="sec">حسب نوع الذكر</p>${list.map(a=>`<div style="margin-bottom:12px"><div class="row" style="margin-bottom:6px"><span class="sp">${esc(a.name)}</span><b style="color:var(--em)">${fmt(S.totals[a.id]||0)}</b></div><div class="bar" style="height:6px"><i style="width:${(S.totals[a.id]||0)/top*100}%"></i></div></div>`).join('')}</div>`;
};
$('statsBody').addEventListener('click',e=>{const b=e.target.closest('[data-r]');if(b){range=+b.dataset.r;renderStats()}});

/* ===== الإنجازات ===== */
let creating=false,cD='istighfar',cT=1000,cN=7;
const stepper=(id,v,f=fmt)=>`<div class="step"><button data-s="${id}" data-v="1" aria-label="زيادة">+</button><b>${f(v)}</b><button data-s="${id}" data-v="-1" aria-label="إنقاص">−</button></div>`;
const chProg=c=>{let sum=0;const st=parse(c.start);for(let i=0;i<c.days;i++)sum+=S.days[key(addD(st,i))]?.b[c.d]||0;const end=addD(st,c.days-1),td=parse(key());return{sum,ok:sum>=c.target,left:Math.max(0,Math.round((end-td)/864e5)+1),exp:td>end}};
const renderAwards=()=>{
 const got=BADGES.filter(b=>S.badges[b[0]]).length;
 $('awardsBody').innerHTML=`<h1>الإنجازات</h1>
 <div class="card"><div class="row"><p class="sec sp" style="margin:0">تحدياتي</p>${creating?'':'<button class="chip" data-a="new">+ تحدٍّ جديد</button>'}</div>
 ${creating?`<div style="background:var(--soft);border-radius:16px;padding:14px;margin-top:12px">
  <b>نوع الذكر</b><div class="chips" style="margin:8px 0 4px">${allAdhkar().map(a=>`<button class="chip${a.id===cD?' on':''}" data-cd="${a.id}">${esc(a.name)}</button>`).join('')}</div>
  <div class="row" style="margin-top:12px"><b class="sp">العدد المستهدف</b>${stepper('t',cT)}</div>
  <div class="row" style="margin-top:12px"><b class="sp">خلال (أيام)</b>${stepper('n',cN)}</div>
  <div class="row" style="margin-top:14px"><button class="btn" data-a="add">ابدأ التحدي</button><button class="btn ghost" data-a="cancel">إلغاء</button></div></div>`:''}
 ${!S.challenges.length&&!creating?'<p class="small dim" style="margin:10px 0 0">ضع لنفسك تحدياً، مثل: 10,000 استغفار خلال شهر، وتابع تقدّمك يوماً بيوم.</p>':''}
 ${S.challenges.slice().reverse().map(c=>{const p=chProg(c),d=dk(c.d);return`<div class="ch"><div class="row"><b class="sp">${fmt(c.target)} ${esc(d.name)}</b><button class="lnk" data-del="${c.id}">حذف</button></div>
  <div class="bar" style="margin:8px 0"><i style="width:${Math.min(100,p.sum/c.target*100)}%;${p.ok?'background:var(--gold)':''}"></i></div>
  <div class="tiny" style="color:${p.ok?'var(--gold)':'var(--dim)'}">${p.ok?`✓ أنجزت التحدي (${fmt(p.sum)})، تقبّل الله`:p.exp?`انتهت المدة: ${fmt(p.sum)} من ${fmt(c.target)}`:`${fmt(p.sum)} من ${fmt(c.target)} • بقي ${daysL(p.left)}`}</div></div>`}).join('')}</div>
 <div class="card"><p class="sec">الشارات (${got} / ${BADGES.length})</p><div class="badges">${BADGES.map(b=>{const g=!!S.badges[b[0]];return`<div class="bdg${g?' got':''}">${svg(g?b[3]:'lock',g?'var(--gold)':'var(--faint)')}<b>${b[1]}</b><small>${b[2]}</small></div>`}).join('')}</div></div>`;
};
$('awardsBody').addEventListener('click',e=>{
 const t=e.target.closest('button');if(!t)return;const a=t.dataset.a;
 if(a==='new')creating=true;else if(a==='cancel')creating=false;
 else if(a==='add'){S.challenges.push({id:Date.now()+'',d:cD,target:cT,days:cN,start:key()});creating=false;save()}
 else if(t.dataset.cd)cD=t.dataset.cd;
 else if(t.dataset.s==='t'){const st=cT>=10000?1000:100;cT=Math.min(100000,Math.max(100,cT+st*+t.dataset.v))}
 else if(t.dataset.s==='n')cN=Math.min(90,Math.max(1,cN+ +t.dataset.v));
 else if(t.dataset.del){const id=t.dataset.del;confirmM('حذف التحدي','هل تريد حذف هذا التحدي؟','حذف',()=>{S.challenges=S.challenges.filter(c=>c.id!==id);save();renderAwards()});return}
 renderAwards();
});

/* ===== الإعدادات ===== */
const remRow=(k,label)=>{const r=S.settings.rem[k],v=r.h*60+r.m;return`<div class="row" style="margin-top:12px"><span class="sp">${label}</span><button class="tog${r.on?' on':''}" data-rk="${k}" aria-label="${label}" aria-pressed="${r.on}"></button></div>
 ${r.on?`<div class="row" style="margin-top:8px"><span class="sp small dim">الوقت</span><div class="step"><button data-rt="${k}" data-v="15" aria-label="تأخير">+</button><b>${hm(r.h,r.m)}</b><button data-rt="${k}" data-v="-15" aria-label="تقديم">−</button></div></div>`:''}`};
const renderSettings=()=>{
 const s=S.settings,r=s.rem;
 $('settingsBody').innerHTML=`<h1>الإعدادات</h1>
 <div class="card"><p class="sec">المظهر</p>
 <div class="row"><button class="chip${s.dark?' on':''}" data-dark="1" style="flex:1">🌙 داكن</button><button class="chip${!s.dark?' on':''}" data-dark="0" style="flex:1">☀️ فاتح</button></div>
 <b style="display:block;margin:16px 0 10px">لون التطبيق</b>
 <div class="row" style="flex-wrap:wrap;gap:14px">${ACCENTS.map(a=>`<button class="swl" data-acc="${a[0]}" aria-label="${a[1]}"><span class="sw${s.accent===a[0]?' on':''}" style="background:linear-gradient(135deg,${a[3]},${a[2]},${a[5]})">${s.accent===a[0]?'✓':''}</span>${a[1]}</button>`).join('')}</div></div>
 <div class="card"><p class="sec">الهدف اليومي</p><div class="chips">${[100,300,500,1000].map(g=>`<button class="chip${s.goal===g?' on':''}" data-g="${g}">${fmt(g)}</button>`).join('')}</div>
 <div class="row" style="margin-top:14px"><span class="sp">هدف مخصص</span>${stepper('g',s.goal)}</div></div>
 <div class="card"><p class="sec">تجربة الذكر</p>
 <div class="row"><span class="sp">صوت هادئ عند الضغط</span><button class="tog${s.sound?' on':''}" data-k="sound" aria-label="الصوت" aria-pressed="${s.sound}"></button></div>
 <div class="row" style="margin-top:12px"><span class="sp">الاهتزاز</span><button class="tog${s.vib?' on':''}" data-k="vib" aria-label="الاهتزاز" aria-pressed="${s.vib}"></button></div>
 <b style="display:block;margin:16px 0 8px">سرعة حركة الدائرة</b>
 <div class="row">${[['calm','هادئة'],['medium','متوسطة'],['fast','سريعة']].map(([k,l])=>`<button class="chip${s.speed===k?' on':''}" data-sp="${k}" style="flex:1">${l}</button>`).join('')}</div></div>
 <div class="card"><p class="sec">أذكاري الخاصة</p>
 ${S.custom.length?S.custom.map(c=>`<div class="row" style="padding:8px 0;border-top:1px solid var(--line)"><span class="sp q" style="font-size:18px">${esc(c.text)}</span><button class="lnk" data-dc="${c.id}">حذف</button></div>`).join(''):'<p class="small dim" style="margin:0">لم تضف أذكاراً خاصة بعد. أضفها من زر «＋ ذكر خاص» في الشاشة الرئيسية.</p>'}</div>
 <div class="card"><p class="sec">التنبيهات</p>
 ${NATIVE?remRow('morning','☀️ أذكار الصباح')+remRow('evening','🌙 أذكار المساء')+remRow('wird','📿 تذكير إن لم يكتمل الورد')+
 `<div style="height:1px;background:var(--line);margin:14px 0 2px"></div><div class="row" style="margin-top:12px"><span class="sp">🌿 تنبيهات الاستغفار خلال اليوم</span><button class="tog${r.ist.on?' on':''}" data-rk="ist" aria-label="تنبيهات الاستغفار" aria-pressed="${r.ist.on}"></button></div>
 ${r.ist.on?`<div class="chips" style="margin-top:10px">${[9,11,13,15,17,20,22].map(h=>`<button class="chip${r.ist.hours.includes(h)?' on':''}" data-ih="${h}">${hm(h,0)}</button>`).join('')}</div>`:''}`
 :'<p class="small dim" style="margin:0">التنبيهات تعمل في تطبيق الجوال.</p>'}</div>
 <div class="card"><p class="sec">البيانات</p><p class="small dim" style="margin:0 0 12px">تُحفظ أذكارك وإحصائياتك على جهازك فقط، ولا تُرسل إلى أي خادم.</p><button class="btn danger" data-a="reset">تصفير العدادات والإحصائيات</button></div>
 <p class="tiny" style="text-align:center;color:var(--faint)">ذِكْر • الإصدار 1.0</p>`;
};
$('settingsBody').addEventListener('click',async e=>{
 const t=e.target.closest('button');if(!t)return;const s=S.settings,d=t.dataset;
 if(d.dark!==undefined){s.dark=d.dark==='1';applyTheme()}
 else if(d.acc){s.accent=d.acc;applyTheme()}
 else if(d.g){s.goal=+d.g;reschedule()}
 else if(d.s==='g'){const st=s.goal>=1000?100:33;s.goal=Math.min(100000,Math.max(33,s.goal+st*+d.v));reschedule()}
 else if(d.k)s[d.k]=!s[d.k];
 else if(d.sp){s.speed=d.sp;next()}
 else if(d.dc){delCustom(d.dc);return}
 else if(d.rk){const r=s.rem[d.rk];r.on=!r.on;if(r.on&&!(await askNotif())){r.on=false;modal(`<b style="font-size:18px">التنبيهات متوقفة</b><p>فعّل إذن الإشعارات لتطبيق ذِكْر من إعدادات الجوال لتصلك التذكيرات.</p><button class="btn" data-close>حسناً</button>`)}reschedule()}
 else if(d.rt){const r=s.rem[d.rt];let v=(r.h*60+r.m+ +d.v+1440)%1440;r.h=Math.floor(v/60);r.m=v%60;reschedule()}
 else if(d.ih){const h=+d.ih,a=s.rem.ist.hours;s.rem.ist.hours=a.includes(h)?a.filter(x=>x!==h):[...a,h].sort((x,y)=>x-y);reschedule()}
 else if(d.a==='reset'){confirmM('تصفير البيانات','سيتم حذف جميع العدادات والإحصائيات والشارات والتحديات. لا يمكن التراجع.','تصفير',()=>{const st=S.settings,cu=S.custom;S=structuredClone(DEF);S.settings=st;S.custom=cu;S.onboarded=true;save();renderAll();reschedule()});return}
 save();renderSettings();renderHome();
});

/* ===== التنقل ===== */
let cur='home';
const show=t=>{cur=t;document.querySelectorAll('.view').forEach(v=>v.classList.toggle('on',v.id==='v-'+t));document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t===t));
 if(t==='azkar')renderAzkar();if(t==='stats')renderStats();if(t==='awards')renderAwards();if(t==='settings')renderSettings();if(t==='home'){renderHome();measure()}};
$('tabs').addEventListener('click',e=>{const b=e.target.closest('[data-t]');if(b){hLight();show(b.dataset.t)}});
const renderAll=()=>{renderHome();if(cur!=='home')show(cur)};
document.addEventListener('visibilitychange',()=>{if(document.hidden)saveNow();else{renderAll();reschedule()}});

let ig=500;
const rIntro=()=>$('introGoals').innerHTML=[100,500,1000].map(g=>`<button class="chip${ig===g?' on':''}" data-ig="${g}" style="padding:9px 22px">${fmt(g)}</button>`).join('');
$('introGoals').addEventListener('click',e=>{const b=e.target.closest('[data-ig]');if(b){ig=+b.dataset.ig;rIntro()}});
$('startBtn').onclick=async()=>{S.settings.goal=ig;S.onboarded=true;saveNow();$('tabs').hidden=false;show('home');if(NATIVE&&await askNotif())reschedule()};
if(S.onboarded){$('tabs').hidden=false;show('home');reschedule()}else{rIntro();$('v-intro').classList.add('on')}
}
</script>
</body>
</html>
