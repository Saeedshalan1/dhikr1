<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#03140F">
<title>ذِكْر</title>
<style>
/* VOICE: هادئ وخاشع، تطبيق جوال حقيقي
   IDEA: سبحة تتوهّج في ليلة هادئة
   PICTURE: الدائرة المضيئة المتحركة داخل مساحة الذكر
   COLOUR and TYPE: ألوان من اختيار المستخدم؛ أميري للأذكار وتجوّل للواجهة
   LAYOUT: إطار تطبيق بعرض الجوال، 5 تبويبات سفلية */
@font-face{font-family:Amiri;src:url(fonts/Amiri-Regular.ttf);font-weight:400}
@font-face{font-family:Amiri;src:url(fonts/Amiri-Bold.ttf);font-weight:700}
@font-face{font-family:Tajawal;src:url(fonts/Tajawal-Regular.ttf);font-weight:400}
@font-face{font-family:Tajawal;src:url(fonts/Tajawal-Medium.ttf);font-weight:500}
@font-face{font-family:Tajawal;src:url(fonts/Tajawal-Bold.ttf);font-weight:700}
@font-face{font-family:Tajawal;src:url(fonts/Tajawal-ExtraBold.ttf);font-weight:800}
:root{--bg:#03140F;--soft:#062019;--card:#0A2A21;--line:#13402F;--ink:#ECF5F0;--dim:#8FB3A5;--faint:#5C8173;--gold:#E8C46E;--red:#E26D5C;--track:#23463A;
 --em:#10B981;--eml:#34D399;--emd:#0B7A57;--emk:#076046;--on:#03140F}
*{box-sizing:border-box;min-width:0;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font:16px/1.55 Tajawal,"Noto Sans Arabic",system-ui,sans-serif;overflow:hidden;transition:background .3s}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
input{-webkit-user-select:text;user-select:text}
button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.app{max-width:520px;height:100dvh;margin:auto;display:flex;flex-direction:column;position:relative;padding-top:var(--safe-area-inset-top,0px)}
.view{flex:1;overflow-y:auto;display:none;flex-direction:column;-webkit-overflow-scrolling:touch}
.view.on{display:flex}
.pad{padding:16px;display:flex;flex-direction:column;gap:14px}
.q{font-family:Amiri,serif}
h1{font:800 26px/1.2 Tajawal,system-ui;margin:0}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:16px}
.sec{color:var(--gold);font-weight:700;font-size:15px;margin:0 0 10px}
.row{display:flex;align-items:center;gap:10px}
.sp{flex:1}
.dim{color:var(--dim)}.small{font-size:13px}.tiny{font-size:12px}
.chip{border:1px solid var(--line);background:var(--card);border-radius:99px;padding:9px 15px;font-size:14px;min-height:40px;white-space:nowrap}
.chip.on{background:var(--em);border-color:var(--em);color:var(--on);font-weight:700}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.scrollx{display:flex;gap:8px;overflow-x:auto;padding:4px 20px;scrollbar-width:none;flex:none}.scrollx::-webkit-scrollbar{display:none}
.bar{height:10px;border-radius:10px;background:color-mix(in srgb,var(--ink) 8%,transparent);overflow:hidden}
.bar i{display:block;height:100%;border-radius:10px;background:var(--em);transition:width .3s}
.btn{width:100%;border:1px solid var(--em);background:var(--em);color:var(--on);border-radius:16px;padding:14px;font-weight:700;font-size:16px;min-height:48px}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.danger{background:transparent;color:var(--red);border-color:var(--red)}
.step{display:flex;align-items:center;gap:6px}
.step button{width:40px;height:40px;border-radius:50%;background:var(--soft);border:1px solid var(--line);color:var(--em);font-size:20px;font-weight:700}
.step b{min-width:84px;text-align:center}
.tog{width:52px;height:30px;border-radius:30px;border:0;background:var(--track);position:relative;flex:none;transition:.2s}
.tog::after{content:"";position:absolute;top:4px;right:4px;width:22px;height:22px;border-radius:50%;background:var(--faint);transition:.2s}
.tog.on{background:color-mix(in srgb,var(--em) 40%,transparent)}.tog.on::after{right:26px;background:var(--em)}
/* الرئيسية */
.head{padding:4px 20px 6px}
.logo{font:700 30px/1.6 Amiri,serif;color:var(--gold)}
.pill{background:color-mix(in srgb,var(--gold) 16%,transparent);color:var(--gold);border-radius:99px;padding:6px 12px;font-weight:700;font-size:14px}
.counter{text-align:center;margin-top:8px}
.phrase{font:700 28px/1.4 Amiri,serif;padding:0 20px;min-height:40px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.num{font:800 56px/1.1 Tajawal,system-ui;color:var(--em)}
.arena{flex:1;min-height:220px;margin:10px 16px 0;border-radius:28px;border:1px solid var(--line);background:linear-gradient(color-mix(in srgb,var(--em) 10%,var(--soft)),var(--soft));position:relative;overflow:hidden;touch-action:manipulation}
.arena canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.orbw{position:absolute;left:0;top:0;width:116px;height:116px;will-change:transform}
.glow{position:absolute;inset:-22px;border-radius:50%;background:color-mix(in srgb,var(--em) 38%,transparent);filter:blur(10px);animation:br 3.6s ease-in-out infinite}
@keyframes br{50%{transform:scale(1.18);opacity:.6}}
.ring{position:absolute;inset:0;border-radius:50%;border:2px solid var(--gold);opacity:0;pointer-events:none}
.ring.go{animation:rg .65s ease-out}
@keyframes rg{from{opacity:.8;transform:scale(1)}to{opacity:0;transform:scale(1.9)}}
.orb{position:absolute;inset:0;border-radius:50%;border:0;background:linear-gradient(160deg,var(--eml),var(--em) 55%,var(--emk));box-shadow:0 0 26px color-mix(in srgb,var(--em) 45%,transparent),inset 0 2px 8px rgba(255,255,255,.25);color:#fff;font-weight:700;font-size:14px;line-height:1.3;transition:transform .08s}
.orb::before{content:"";position:absolute;inset:9px;border-radius:50%;border:1.5px solid rgba(255,255,255,.35)}
.orb.hit{transform:scale(.86)}
.float{position:absolute;width:236px;text-align:center;pointer-events:none;animation:fl 1.1s ease-out forwards}
.float span{display:block;font:700 18px Amiri,serif;color:var(--gold)}
.float b{color:var(--em);font-size:14px}
@keyframes fl{0%{opacity:0;transform:translateY(0)}15%{opacity:1}100%{opacity:0;transform:translateY(-90px)}}
.pause{position:absolute;bottom:10px;left:12px;background:color-mix(in srgb,var(--bg) 60%,transparent);border:0;border-radius:99px;padding:6px 12px;font-size:12px;font-weight:700;color:var(--dim);min-height:32px}
.goal{margin:12px 16px 10px;padding:14px}
.toast{position:absolute;bottom:calc(84px + var(--safe-area-inset-bottom,0px));left:16px;right:16px;background:var(--card);border:1px solid var(--gold);border-radius:18px;padding:14px;display:flex;gap:12px;align-items:center;transform:translateY(30px);opacity:0;transition:.3s;pointer-events:none;z-index:5;box-shadow:0 10px 30px rgba(0,0,0,.25)}
.toast.on{transform:none;opacity:1}
/* أذكار الصباح والمساء */
.zk{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:14px 16px 12px;text-align:start;width:100%;transition:opacity .3s,border-color .3s}
.zk p{font:400 19px/1.95 Amiri,serif;margin:0 0 10px;white-space:pre-line}
.zk.done{opacity:.55;border-color:var(--em)}
.zk .cnt{border-radius:99px;padding:6px 14px;font-size:13px;font-weight:700;background:color-mix(in srgb,var(--em) 14%,transparent);color:var(--em);transition:.25s}
.zk.done .cnt{background:var(--em);color:var(--on)}
.zk.pop{animation:pp .18s}
@keyframes pp{50%{transform:scale(.98)}}
/* التبويبات */
.tabs{display:flex;border-top:1px solid var(--line);background:var(--soft);padding:8px 0 calc(8px + var(--safe-area-inset-bottom,0px))}
.tabs button{flex:1;background:none;border:0;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;color:var(--faint);min-height:48px}
.tabs svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
.tabs button.on{color:var(--em);font-weight:700}
.tabs button.on svg{transform:scale(1.12)}
.tabs button::after{content:"";width:4px;height:4px;border-radius:4px;background:transparent;transition:.2s}
.tabs button.on::after{width:16px;background:var(--em)}
/* إحصائيات */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat b{display:block;font-size:24px;font-weight:800;margin-top:2px}
.chart{height:160px;display:flex;align-items:flex-end;gap:3px;position:relative}
.chart .col{flex:1;display:flex;justify-content:center;align-items:flex-end;height:100%}
.chart .col i{display:block;border-radius:6px;background:var(--emd)}
.chart .col i.done{background:var(--em)}
.gl{position:absolute;left:0;right:0;border-top:1px dashed var(--gold);opacity:.6}
.days{display:flex;gap:3px;margin-top:6px}.days span{flex:1;text-align:center;font-size:11px;color:var(--dim)}
/* إنجازات */
.badges{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.bdg{background:var(--soft);border:1px solid var(--line);border-radius:18px;padding:12px 6px;text-align:center}
.bdg.got{border-color:var(--gold);background:color-mix(in srgb,var(--gold) 7%,transparent)}
.bdg svg{width:34px;height:34px}
.bdg b{display:block;font-size:13px;margin-top:6px;color:var(--dim)}.bdg.got b{color:var(--gold)}
.bdg small{display:block;font-size:11px;color:var(--faint);line-height:1.35;margin-top:2px}
.ch{padding:12px 0;border-top:1px solid var(--line)}
.lnk{background:none;border:0;color:var(--faint);font-size:13px;padding:6px}
.sw{width:44px;height:44px;border-radius:50%;border:3px solid transparent;display:grid;place-items:center;color:#fff;font-weight:800}
.sw.on{border-color:var(--ink)}
.swl{display:flex;flex-direction:column;align-items:center;gap:4px;background:none;border:0;font-size:11px;color:var(--dim);padding:0}
/* نافذة */
.modal{position:absolute;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;padding:24px;z-index:10}
.modal.on{display:flex}
.mbox{width:100%;max-width:380px;background:var(--card);border:1px solid var(--gold);border-radius:28px;padding:24px;text-align:center}
.mbox input{width:100%;background:var(--soft);border:1px solid var(--line);border-radius:14px;padding:12px 14px;font:400 20px Amiri,serif;margin:12px 0 4px;outline:none}
.mbox input:focus{border-color:var(--em)}
.star{width:64px;height:64px;margin:auto;display:block}
@media(prefers-reduced-motion:reduce){.glow,.float,.ring.go{animation:none}}
</style>
</head>
<body>
<div class="app" id="app">

  <section class="view" id="v-intro" style="justify-content:center;padding:28px;text-align:center">
    <div class="q" style="font-size:64px;font-weight:700;color:var(--gold);line-height:1.6">ذِكْر</div>
    <div class="q dim" style="font-size:18px">﴿فَاذْكُرُونِي أَذْكُرْكُمْ﴾</div>
    <p style="margin:28px 0 0">اضغط على الدائرة المضيئة كلما ظهرت لتسبّح وتستغفر، واجمع أيامك المتتالية وشاراتك بهدوء.</p>
    <p style="color:var(--gold);font-weight:700;margin:30px 0 12px">اختر هدفك اليومي</p>
    <div class="chips" id="introGoals" style="justify-content:center"></div>
    <p class="tiny" style="color:var(--faint)">يمكنك تغييره لاحقاً من الإعدادات</p>
    <button class="btn" id="startBtn" style="margin-top:26px">ابدأ الذكر</button>
  </section>

  <section class="view" id="v-home" style="overflow:hidden">
    <div class="head">
      <div class="row"><span class="logo">ذِكْر</span><span class="sp"></span><span class="pill" id="streakPill"></span></div>
      <div class="q dim" style="font-size:15px">﴿أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ﴾</div>
    </div>
    <div class="scrollx" id="dhikrChips"></div>
    <div class="counter">
      <div class="phrase" id="phrase"></div>
      <div class="num" id="num">0</div>
      <div class="dim small" id="numLbl" style="margin-top:-4px"></div>
    </div>
    <div class="arena" id="arena">
      <canvas id="fx"></canvas>
      <div class="orbw" id="orbw">
        <div class="glow"></div><div class="ring" id="ring"></div>
        <button class="orb" id="orb" aria-label="اضغط للذكر">اضغط<br>للذكر</button>
      </div>
      <button class="pause" id="pauseBtn">❚❚ ثبات</button>
    </div>
    <div class="card goal">
      <div class="row small" style="font-weight:700"><span id="goalLbl"></span><span class="sp"></span><span id="goalPct" style="color:var(--em)"></span></div>
      <div class="bar" style="margin:8px 0 6px"><i id="goalBar"></i></div>
      <div class="tiny dim" id="goalTxt"></div>
    </div>
  </section>

  <section class="view" id="v-azkar"><div class="pad" id="azkarBody"></div></section>
  <section class="view" id="v-stats"><div class="pad" id="statsBody"></div></section>
  <section class="view" id="v-awards"><div class="pad" id="awardsBody"></div></section>
  <section class="view" id="v-settings"><div class="pad" id="settingsBody"></div></section>

  <nav class="tabs" id="tabs" hidden>
    <button data-t="home" class="on"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/></svg>الذكر</button>
    <button data-t="azkar"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>الأذكار</button>
    <button data-t="stats"><svg viewBox="0 0 24 24"><path d="M5 20V11M12 20V5M19 20v-6"/></svg>الإحصائيات</button>
    <button data-t="awards"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M8.5 13 7 21l5-3 5 3-1.5-8"/></svg>الإنجازات</button>
    <button data-t="settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>الإعدادات</button>
  </nav>

  <div class="toast" id="toast"><span id="toastIc"></span><div><b style="color:var(--gold)" id="toastT"></b><div class="tiny dim" id="toastD"></div></div></div>
  <div class="modal" id="modal"><div class="mbox" id="mbox"></div></div>
</div>

<script>
{
const $=id=>document.getElementById(id);
const esc=t=>String(t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

/* ===== الجهاز (Capacitor) ===== */
const CAP=window.Capacitor;
const NATIVE=!!(CAP&&CAP.isNativePlatform&&CAP.isNativePlatform());
const PL=NATIVE?CAP.Plugins:{};

/* ===== البيانات ===== */
const ADHKAR=[
 {id:'istighfar',name:'الاستغفار',p:['أستغفر الله']},
 {id:'tasbih',name:'التسبيح',p:['سبحان الله']},
 {id:'tahlil',name:'التهليل',p:['لا إله إلا الله']},
 {id:'takbir',name:'التكبير',p:['الله أكبر']},
