  if(r.ist.on)r.ist.hours.forEach((h,i)=>daily(10+i,'🌿 لحظة استغفار',ISTM[i%ISTM.length],h,0));
  if(r.wird.on){const now=new Date();for(let i=0;i<7;i++){const d=addD(now,i),at=new Date(d.getFullYear(),d.getMonth(),d.getDate(),r.wird.h,r.wird.m);if(at<=now)continue;if(i===0&&done(key(d)))continue;const left=Math.max(0,S.settings.goal-dayT(key(d)));
