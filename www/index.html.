const doSchedule=async()=>{
 if(!LN)return;
 try{
  const p=await LN.checkPermissions();
  await LN.cancelAll().catch(async()=>{const pend=await LN.getPending();if(pend.notifications.length)await LN.cancel({notifications:pend.notifications})});
  if(p.display!=='granted')return;
  await LN.createChannel({id:'reminders',name:'تذكير الأذكار',importance:4,vibration:true}).catch(()=>{});
  const r=S.settings.rem,list=[],base={channelId:'reminders',smallIcon:'ic_stat_dhikr',iconColor:'#10B981'};
  const daily=(id,title,body,h,m)=>list.push({...base,id,title,body,schedule:{on:{hour:h,minute:m}}});
  if(r.morning.on)daily(1,'☀️ أذكار الصباح','ابدأ يومك بذكر الله، فبذكره تطمئن القلوب',r.morning.h,r.morning.m);
