let phraseIdx=0,paused=false;
const arena=$('arena'),orbw=$('orbw'),O=116,fx=$('fx'),ctx=fx.getContext('2d');
let A={w:0,h:0},from={x:0,y:0},to={x:0,y:0},t0=0,dur=1,pos={x:0,y:0};
const RANGE={calm:[3200,4200],medium:[1900,2600],fast:[1100,1500]};
const ease=t=>-(Math.cos(Math.PI*t)-1)/2;
const center=()=>({x:(A.w-O)/2,y:(A.h-O)/2});
const next=()=>{const p=12,[a,b]=RANGE[S.settings.speed]||RANGE.calm;from={...pos};to=paused?center():{x:p+Math.random()*Math.max(1,A.w-O-p*2),y:p+Math.random()*Math.max(1,A.h-O-p*2)};dur=paused?600:a+Math.random()*(b-a);t0=performance.now()};
const stars=[...Array(38)].map(()=>({x:Math.random(),y:Math.random(),r:.6+Math.random()*1.4,ph:Math.random()}));
let bursts=[];
const measure=()=>{const r=arena.getBoundingClientRect();if(!r.width)return;const first=!A.w;A={w:r.width,h:r.height};const dpr=window.devicePixelRatio||1;fx.width=r.width*dpr;fx.height=r.height*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);if(first){pos=center();next()}};
new ResizeObserver(measure).observe(arena);
const loop=now=>{
 if(A.w&&$('v-home').classList.contains('on')){
  const k=Math.min(1,(now-t0)/dur);pos={x:from.x+(to.x-from.x)*ease(k),y:from.y+(to.y-from.y)*ease(k)};
  orbw.style.transform=`translate(${pos.x}px,${pos.y}px)`;if(k>=1&&!paused)next();
  const cs=getComputedStyle(document.documentElement),ink=S.settings.dark?cs.getPropertyValue('--ink'):cs.getPropertyValue('--em'),gold=cs.getPropertyValue('--gold'),eml=cs.getPropertyValue('--eml');
  ctx.clearRect(0,0,A.w,A.h);
  stars.forEach(s=>{const tw=.5+.5*Math.sin((now/3600+s.ph)*Math.PI*2);ctx.globalAlpha=.06+.22*tw;ctx.fillStyle=ink;ctx.beginPath();ctx.arc(s.x*A.w,s.y*A.h,s.r,0,7);ctx.fill()});
  bursts=bursts.filter(b=>now-b.t<700);
  bursts.forEach(b=>{const t=(now-b.t)/700,e=1-Math.pow(1-t,3);for(let i=0;i<12;i++){const ang=b.spin+i*Math.PI/6,r=O/2+6+e*(i%2?26:38);ctx.globalAlpha=(1-t)*.9;ctx.fillStyle=i%2?eml:gold;ctx.beginPath();ctx.arc(b.x+Math.cos(ang)*r,b.y+Math.sin(ang)*r,(i%2?2.2:3.2)*(1-t*.6),0,7);ctx.fill()}});
  ctx.globalAlpha=1;
 }
 requestAnimationFrame(loop)};
requestAnimationFrame(loop);
